

<div class="row">
    <div class="col-6">
        <img src="@prod.Img" alt="">
    </div>
    <div class="col-6">
        <b>Name: @prod.Name</b>
        <b>Description: @prod.Description</b>
        <b>Price: @prod.Price</b>
    </div>
</div>

@code{
    [Parameter]
    public ProductDto prod {get;set;}
}