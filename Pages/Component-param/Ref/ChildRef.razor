<h4>@count</h4>
<button class="btn btn-primary" @onclick="Increase">+

</button>

@code{
    private int count;
    private void Increase(){
        count++;
    }
    @* state o dau thi hamm thay doi dat o do *@
    public void Reset(){
        count=0;;
        StateHasChanged();
    }
    public void Sub(){
        count--;;
        StateHasChanged();
    }
}